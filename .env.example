# === Data source mode ===
# fixture = use bundled sanitized sample payloads (default, no credentials needed)
# live    = call real retailer endpoints (Walmart Affiliate API, Pokemon Center storefront JSON)
DATA_SOURCE_MODE=fixture

# === Raw storage backend ===
# local = write to RAW_DATA_PATH on disk (default)
# s3    = write to S3_BUCKET under AWS_REGION
RAW_STORAGE_BACKEND=local
RAW_DATA_PATH=./data/raw

# === AWS (only required when RAW_STORAGE_BACKEND=s3) ===
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# === Retailer live-mode credentials (only required when DATA_SOURCE_MODE=live) ===
WALMART_API_KEY=
TARGET_STORE_ID=3991

# === Snowflake ===
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=RETAIL_INVENTORY_ROLE
SNOWFLAKE_WAREHOUSE=RETAIL_INVENTORY_WH
SNOWFLAKE_DATABASE=RETAIL_INVENTORY
SNOWFLAKE_SCHEMA=RAW

# Used only by dbt_inventory/profiles.yml (the target schema dbt builds
# staging/intermediate/marts under, as ANALYTICS_STAGING etc.)
SNOWFLAKE_SCHEMA_ANALYTICS=ANALYTICS
# dbt profile target: dev (password auth) or ci (key-pair auth)
DBT_TARGET=dev

# === App config ===
LOG_LEVEL=INFO
PIPELINE_VERSION=0.1.0
